# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Estado del teleprompter (guion y ajustes)
state.json

# Estado apartado o a medio escribir
state.json.bak
state.json.tmp

# servidor compilado
/dist/

# --- apps nativas (apple/)
# El proyecto de Xcode lo genera XcodeGen a partir de apple/project.yml, que es
# la fuente de verdad. Versionarlo solo traería conflictos en un fichero que
# nadie edita a mano.
apple/*.xcodeproj
apple/.build
apple/Packages/*/.build
**/xcuserdata/

# Copia de la app de Mac para poder abrirla con doble clic.
apple/build/
