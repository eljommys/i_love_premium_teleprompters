    "Apunta con la cámara del otro aparato. Lleva el código dentro, así que entra sin teclear nada.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the other device’s camera at it. The code travels inside, so it gets in without typing anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta con la cámara del otro aparato. Lleva el código dentro, así que entra sin teclear nada."
          }
        }
      }
    },
